<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvSequence"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvBibNumber"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="201"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@color/bibYellow"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <TextView
        android:id="@+id/tvCrewName"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="Peter Anderson"
        android:textSize="14sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>

    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Middle School"
        android:textSize="12sp"
        android:ellipsize="end"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/tvRaceClock"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="20:17.3"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@color/bibYellow"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

</LinearLayout>
