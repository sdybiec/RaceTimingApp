<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Menu Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home"
            style="@style/TitleBarButton"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_indicator"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/race_finish"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/results"
            style="@style/TitleBarButton"/>
    </LinearLayout>

    <!-- Title Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        android:gravity="center"
        android:background="#FFFFFF">

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#ff6600"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tvRaceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bellevue Cup MTB Race"
            android:textSize="20sp"
            android:textColor="#333333"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tvRaceClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:14.9"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- Grid of Crew Buttons (ScrollView) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/crewButtonGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="8"
            android:padding="10dp"
            android:rowCount="13"
            android:useDefaultMargins="true"
            android:alignmentMode="alignBounds"/>
    </ScrollView>

    <!-- Status Label -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#f0f0f0"
        android:text="Tap bib when racer finishes"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>

    <!-- Bottom Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#2a2a2a"
        android:gravity="center">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="❓\nHelp"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="⚠\nRace control"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📋\nStart list"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="👤\nShow name"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="DNS/DNF/DSQ"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="👁\nFast-lap view"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="+/−\nShow splits"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="10sp"/>
    </LinearLayout>

</LinearLayout>
