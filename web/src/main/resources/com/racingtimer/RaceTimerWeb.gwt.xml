<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.10.0//EN"
        "http://www.gwtproject.org/doctype/2.10.0/gwt-module.dtd">
<module rename-to='racetimerweb'>
    <!-- Inherit the core Web Toolkit stuff -->
    <inherits name='com.google.gwt.user.User'/>

    <!-- Inherit shared module -->
    <inherits name='com.racingtimer.Shared'/>

    <!-- Default theme -->
    <inherits name='com.google.gwt.user.theme.standard.Standard'/>

    <!-- Specify the app entry point class -->
    <entry-point class='com.racingtimer.client.RaceTimerWeb'/>

    <!-- Specify source paths -->
    <source path='client'/>
    <source path='shared'/>
</module>
